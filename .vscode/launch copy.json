{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [
        "-b",
        "0.0.0.0",
        "-p",
        "8000"
      ],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "/home/hsj/Desktop/PROJECTS/networking-c",
      "program": "/home/hsj/Desktop/PROJECTS/networking-c/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Fork follows Child process",
          "text": "set follow-fork-mode child",
          "ignoreFailures": true
        },
        {
          "description": "Fork will keep the other process attached to debugger",
          "text": "set detach-on-fork off",
          "ignoreFailures": true
        }
      ]
    }
  ]
}